# Devnet only. Set this to a public recipient address; never put a private key here.
SOLANA_WALLET_ADDRESS=

# Required by the upstream AI provider. Do not commit your real value.
UPSTREAM_API_KEY=

# Optional settings. Defaults are safe for the local Devnet demo.
LISTEN_ADDR=:8080
SOLANA_RPC_URL=https://api.devnet.solana.com
UPSTREAM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-3.8-flash
PAYMENT_PER_TOKEN_LAMPORTS=10
RPC_TIMEOUT_SECONDS=5
SIGNATURE_CACHE_SIZE=10000

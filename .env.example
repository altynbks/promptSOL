LISTEN_ADDR=:8080
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WALLET_ADDRESS=replace_with_your_devnet_wallet
UPSTREAM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
UPSTREAM_API_KEY=replace_with_gemini_api_key
AI_MODEL=gemini-3.8-flash
GROQ_API_KEY=replace_with_groq_api_key
GROQ_BASE_URL=https://api.groq.com/openai
GROQ_MODEL=openai/gpt-oss-20b
PAYMENT_LAMPORTS=1000
INPUT_LAMPORTS_PER_1K_TOKENS=2000
OUTPUT_LAMPORTS_PER_1K_TOKENS=8000
RPC_TIMEOUT_SECONDS=20
SIGNATURE_CACHE_SIZE=10000
